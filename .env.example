# Copy to .env and fill in. Never commit the real .env.
# Keys are read only from environment variables or st.secrets.

# Provider selection: openai | nvidia | voyager | mock
LLM_PROVIDER=nvidia

# OpenAI (gateway default provider for several roles)
OPENAI_API_KEY=

# NVIDIA (default in deployed app): https://integrate.api.nvidia.com/v1
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.3-70b-instruct
NVIDIA_JUDGE_MODEL=qwen/qwen2.5-7b-instruct

# Voyager (ASU, local only, requires ASU VPN): https://openai.rc.asu.edu/v1
VOYAGER_API_KEY=
VOYAGER_MODEL=gemma4-31b-it

# Path to the raw Yelp dataset directory (gitignored data).
YELP_DIR=./data/yelp_dataset

# Example Streamlit secrets for Location Risk Radar.
# Copy to .streamlit/secrets.toml for local Live mode, or paste the same TOML into
# the Streamlit Community Cloud app's Advanced settings -> Secrets box.
# NEVER commit a real secrets.toml. Only this .example file is tracked.
#
# The gateway reads these from st.secrets first, then from environment variables.
# With no keys set, the app runs in Cached mode and spends nothing.

# Provider selection for the deployed app. nvidia is the default.
# One of: nvidia | openai | mock   (voyager is local-only; see note below)
LLM_PROVIDER = "nvidia"

# NVIDIA Integrate (default in the deployed app):
#   https://integrate.api.nvidia.com/v1
NVIDIA_API_KEY = ""

# OpenAI (used by several gateway roles when present):
OPENAI_API_KEY = ""

# Abuse protection on the public URL. All optional; sensible defaults apply.
# Per-session cap on live model calls.
LIVE_CALL_CAP = "25"
# Hard ceiling on max_tokens for any single live call.
GATEWAY_MAX_TOKENS_PER_CALL = "1024"
# Global estimated daily spend guard in USD. 0 disables the guard.
GATEWAY_DAILY_BUDGET_USD = "2.0"

# NOTE: Voyager (https://openai.rc.asu.edu/v1) requires the ASU VPN and is
# available in local runs only. It is automatically disabled on Streamlit Cloud,
# so do not set VOYAGER_API_KEY here. For local use, add it to a local
# .streamlit/secrets.toml or your environment:
#   VOYAGER_API_KEY = ""
